<!-- 使用stdr的仿真进行hector建图 -->
<launch>

  <!-- 开启stdr仿真器 -->
  <include file = "$(find sebot_simulator)/launch/sebot_stdr_gui.launch" />

  <!-- 启动RVIZ监视器 -->
  <node name = "rviz" pkg  = "rviz" type = "rviz" args = "-d $(find sebot_simulator)/rviz/slam.rviz" respawn="true"/>

  <!-- 开启hector建图算法节点 -->
  <include file="$(find sebot_slam)/param/hector.xml">
    <arg name="map_topic"   value="/slam_map" />              <!-- 发布的地图话题 -->
    <arg name="use_tf_pose_start_estimate" value="true"/>     <!-- 启动姿态估计 -->
  </include>

  <!-- 启动遥控手柄控制节点 -->
  <node pkg="sebot_robot" type="sebot_joystick" name="sebot_joystick" respawn="true"/>

</launch>