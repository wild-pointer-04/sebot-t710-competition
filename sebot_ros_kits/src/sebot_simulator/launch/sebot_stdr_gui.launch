<launch>
	
	<!-- 启动STDR模拟器 -->
	<include file="$(find stdr_robot)/launch/robot_manager.launch" />
	
    <!-- 加载STDR地图 -->
	<node type="stdr_server_node" pkg="stdr_server" name="stdr_server" output="screen" args="$(find sebot_simulator)/resources/map/sebot_match.yaml"/>

	<!-- 发布地图静态坐标系 -->
	<node pkg="tf" type="static_transform_publisher" name="world2map" args="0 0 0 0 0 0  world map 30" />
	
	<!-- 启动STDR图形化界面 -->
	<!-- <include file="$(find stdr_gui)/launch/stdr_gui.launch"/> -->
	
	<!-- 加载商服机器人物理模型 (x y th)机器人起始位置-->
	<node pkg="stdr_robot" type="robot_handler" name="$(anon robot_spawn)" args="add $(find sebot_simulator)/resources/robot/sebot_robot.yaml 1.0 1.0 1.57" />

</launch>

